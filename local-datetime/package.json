{
  "name": "@local/dsh-tool-local-datetime",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Adds the local-datetime tool: the hosting machine's current date and time in the host's own locale and time zone.",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
